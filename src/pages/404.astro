---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";

const title = "页面走丢了";
const description = "这个地址没有对应的页面 —— 它可能被移走、改了名字，或者从来就没存在过。";

// 迷路的人最想知道的不是"为什么 404"，而是"我该去哪儿"。
// 所以额外给三条最近的文章，而不是把人空手送回首页。
const recent = (await getSortedPostsList()).slice(0, 3);
const postUrl = (post: (typeof recent)[number]) => `/posts/${post.data.abbrlink || post.slug}/`;
---

<MainGridLayout title={title} description={description}>
    <Fragment slot="head">
        <meta name="robots" content="noindex, follow" />
    </Fragment>

    <div class="card-base px-6 md:px-10 py-14 md:py-16 flex flex-col items-center text-center relative overflow-hidden">
        <!-- 一层很淡的星尘 + 一团主色光晕，避免整块留白显得"坏掉了" -->
        <div
            class="pointer-events-none absolute inset-0 opacity-[0.05] dark:opacity-[0.07]"
            aria-hidden="true"
            style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 22px 22px;"
        >
        </div>
        <div
            class="pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[26rem] h-[26rem] rounded-full blur-3xl"
            style="background: color-mix(in oklab, var(--primary) 8%, transparent);"
            aria-hidden="true"
        >
        </div>

        <div
            class="relative w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
            style="background: color-mix(in oklab, var(--primary) 12%, transparent);"
        >
            <Icon name="fa6-solid:paw" class="text-[2rem] text-[var(--primary)]"></Icon>
        </div>

        <div class="relative text-[4.5rem] md:text-[6.5rem] font-bold leading-none tracking-tight bg-gradient-to-br from-[var(--primary)] to-[var(--secondary)] bg-clip-text text-transparent select-none">
            404
        </div>

        <h1 class="relative mt-4 text-2xl md:text-3xl font-bold text-black/85 dark:text-white/85">
            这页不知道飞哪儿去了
        </h1>

        <p class="relative mt-3 text-sm md:text-base text-black/55 dark:text-white/55 leading-relaxed max-w-md">
            它可能被移走、改了名字，或者从来就没存在过。<br />
            要不先回首页，或者去归档里翻翻？
        </p>

        <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="/" class="btn-regular rounded-xl h-11 px-6 font-bold active:scale-95">回首页</a>
            <a href="/archive/" class="btn-regular rounded-xl h-11 px-6 font-bold active:scale-95">翻归档</a>
            <a href="/novels/" class="btn-regular rounded-xl h-11 px-6 font-bold active:scale-95">看小说</a>
        </div>
    </div>

    {recent.length > 0 && (
        <div class="card-base mt-4 px-6 md:px-9 py-6">
            <div class="flex items-center gap-2 mb-3">
                <Icon name="material-symbols:history-rounded" class="text-[1.25rem] text-[var(--primary)]"></Icon>
                <h2 class="text-lg font-bold text-black/80 dark:text-white/80">最近更新</h2>
            </div>
            <ul class="flex flex-col gap-0.5">
                {recent.map((post) => (
                    <li>
                        <a
                            href={postUrl(post)}
                            class="group flex items-baseline justify-between gap-4 rounded-lg px-3 py-2.5 transition hover:bg-[var(--btn-plain-bg-hover)]"
                        >
                            <span class="text-black/75 dark:text-white/75 group-hover:text-[var(--primary)] transition line-clamp-1">
                                {post.data.title}
                            </span>
                            <span class="shrink-0 text-xs text-black/40 dark:text-white/40 tabular-nums">
                                {formatDateToYYYYMMDD(post.data.published)}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    )}
</MainGridLayout>

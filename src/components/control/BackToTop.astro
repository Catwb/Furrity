---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    right: 1rem
    bottom: 10rem
    z-index: 40
    opacity: 1
    cursor: pointer
    transform: translateX(0)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateX(calc(100% + 2rem))
        opacity: 0
        pointer-events: none
    &:active
        transform: translateX(0) scale(0.9)

</style>

<script is:raw is:inline>
function backToTop() {
	// OverlayScrollbars 接管 body 滚动时，window.scroll 可能无效，
	// 同时滚动 window / html / body，确保一定回到顶部
	var opts = { top: 0, behavior: 'smooth' };
	window.scrollTo(opts);
	if (document.documentElement.scrollTo) document.documentElement.scrollTo(opts);
	if (document.body.scrollTo) document.body.scrollTo(opts);
}

// 按钮跟随文章主体（#main-grid 容器）右缘，而不是视口边缘
function positionBackToTop() {
	var btn = document.getElementById('back-to-top-btn');
	var wrapper = document.querySelector('.back-to-top-wrapper');
	if (!btn || !wrapper) return;
	var rect = wrapper.getBoundingClientRect();
	// 按钮整体放在文章主体右缘外侧 0.5rem，完全避开正文
	var btnW = btn.offsetWidth || 60;
	var right = Math.max(12, window.innerWidth - rect.right - btnW - 8);
	btn.style.right = right + 'px';
}
window.addEventListener('scroll', positionBackToTop, { passive: true });
window.addEventListener('resize', positionBackToTop);
document.addEventListener('astro:page-load', positionBackToTop);
window.addEventListener('load', positionBackToTop);
positionBackToTop();
</script>

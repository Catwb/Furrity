---
import BackToTop from "@components/control/BackToTop.astro";
import DynamicIsland from "@components/DynamicIsland.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config/site";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	plugins?: string[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	plugins,
} = Astro.props;
const isHomePage = Astro.url.pathname === "/";
const isArticlePage = setOGTypeArticle === true;
const leftSidebarComponents = siteConfig.sidebar?.left ?? [];
const rightSidebarComponents = siteConfig.sidebar?.right ?? [];
const hasLeftSidebar = leftSidebarComponents.length > 0;
const hasArticleToc = isArticlePage && siteConfig.toc.enable && headings.length > 0;
const hasRightSidebar = isArticlePage ? hasArticleToc : rightSidebarComponents.length > 0;

const uniqueComponents = new Set<string>();
for (const [side, components] of [
	["left", leftSidebarComponents],
	["right", rightSidebarComponents],
] as const) {
	for (const component of components) {
		if (component.type === "text") continue;
		if (uniqueComponents.has(component.type)) {
			throw new Error(`Sidebar component "${component.type}" is duplicated in the ${side} sidebar. Only text components can be repeated.`);
		}
		uniqueComponents.add(component.type);
	}
}
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} plugins={plugins}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="fixed top-0 left-0 right-0 z-50 pointer-events-none transition-all duration-700">
    <div class="max-w-[var(--page-width-wide)] mx-auto px-0 md:px-4">
        <div id="navbar-wrapper" class="pointer-events-auto transition-all">
            <Navbar></Navbar>
        </div>
    </div>
    <!--
        灵动岛挂在这里，不挂进 <main> / #right-sidebar-container：
        那两个是 swup 的 containers（astro.config.mjs:129），每次换页整体替换，
        岛会被销毁重建，形变动画每次从零开始。放在 #top-row 里可以跨页存活
        —— navbar 本身就在这两个容器之外。

        它是独立悬浮层：absolute + left:50%，相对 #top-row（fixed，全宽），
        纵向落在 navbar 正下方（见 DynamicIsland.astro 的 #island-slot）。
        #top-row 是 z-50，正文是 z-30，所以岛天然浮在内容之上。
    -->
    {siteConfig.island?.enable && <DynamicIsland />}
</div>

<!-- Banner / Hero -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    {siteConfig.background
        ? <div id="banner" class="h-full w-full"></div>
        : <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                        src={siteConfig.banner.src ?? ""} position={siteConfig.banner.position}>
          </ImageWrapper>
    }
    {isHomePage && <div class="absolute inset-0 z-20 flex flex-col items-center justify-center px-4 text-center pointer-events-none">
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">
            {siteConfig.title}
        </h1>
        <p class="mt-3 md:mt-4 text-base md:text-lg lg:text-xl text-white/85 drop-shadow-[0_1px_4px_rgba(0,0,0,0.5)] max-w-lg">
            {siteConfig.subtitle}
        </p>
    </div>}
</div>}

<!-- Main content -->
<div id="main-panel" class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="main-grid-wrapper relative mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-1 mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            {hasLeftSidebar && <SideBar
                class="order-2 lg:order-none lg:col-start-1 lg:row-start-1 lg:max-w-[17.5rem] onload-animation"
                components={leftSidebarComponents}
                side="left"
            />}

            <!--
                data-article 让移动端只把「文章页的目录」变成底部抽屉，
                普通页面的右侧栏（公告/分类/标签）仍然留在文档流里。
            -->
            <div id="right-sidebar-container" data-active={String(hasRightSidebar)} data-article={String(isArticlePage)} data-toc-open="false" class:list={["order-3 lg:order-none", {
                "hidden": !hasRightSidebar,
            }]}>
                {isArticlePage
                    ? <div id="toc-wrapper" class:list={["h-full transition", {"toc-hide": siteConfig.banner.enable}]}>
                        <div id="toc-inner-wrapper" class="sticky top-[5.5rem] max-h-[calc(100vh_-_7rem)] overflow-y-auto overflow-x-hidden hide-scrollbar">
                            <div id="toc" class="w-full">
                                {hasArticleToc && <div class="transition-swup-fade card-base py-4 px-0">
                                    <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2
                                        before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
                                        before:absolute before:left-[-16px] before:top-[5.5px]">目录</div>
                                    <div class="px-2">
                                        <TOC headings={headings}></TOC>
                                    </div>
                                </div>}
                            </div>
                        </div>
                    </div>
                    : hasRightSidebar && <SideBar components={rightSidebarComponents} side="right" class="lg:max-w-[17.5rem] onload-animation" />
                }
                {!isArticlePage && <div id="toc"></div>}
            </div>

            <main id="swup-container" class:list={["transition-swup-fade order-1 lg:order-none overflow-hidden", {
                "lg:col-start-2 lg:row-start-1": hasLeftSidebar,
                "lg:col-start-1 lg:row-start-1": !hasLeftSidebar,
            }]}>
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer order-4 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <!--
            移动端目录抽屉的遮罩与入口。
            这两个节点必须留在 swup 容器（main / #right-sidebar-container）之外：
            放进去的话，换页时 #swup-container 的 translate-y 动画会让 fixed 元素
            以它为参照而不是视口，遮罩会整体错位。
            代价是它们跨页存活，所以显隐由 JS 在 astro:page-load 时按当前页有没有
            目录重新判断（见文件末尾脚本）。
        -->
        <div id="mobile-toc-overlay" class="mobile-toc-overlay" aria-hidden="true"></div>
        <button id="mobile-toc-toggle" type="button" class="mobile-toc-toggle btn-card"
                data-visible="false" aria-label="目录" aria-expanded="false" aria-controls="right-sidebar-container">
            <Icon name="material-symbols:list-alt-rounded"></Icon>
        </button>

        <BackToTop></BackToTop>

    </div>
</div>
</Layout>

<style is:global>
.main-grid-wrapper {
  max-width: var(--page-width);
}

.main-grid-wrapper:has(#right-sidebar-container[data-active="true"]) {
  max-width: var(--page-width-wide);
}

@media (min-width: 1024px) {
  #main-grid:has(#left-sidebar):has(#right-sidebar-container[data-active="true"]) {
    grid-template-columns: 17.5rem minmax(0, 1fr) 17.5rem;
  }

  #main-grid:has(#left-sidebar):not(:has(#right-sidebar-container[data-active="true"])) {
    grid-template-columns: 17.5rem minmax(0, 1fr);
  }

  #main-grid:not(:has(#left-sidebar)):has(#right-sidebar-container[data-active="true"]) {
    grid-template-columns: minmax(0, 1fr) 17.5rem;
  }

  #main-grid #left-sidebar {
    grid-column: 1;
    grid-row: 1;
  }

  #main-grid:has(#left-sidebar) main {
    grid-column: 2;
    grid-row: 1;
  }

  #main-grid:not(:has(#left-sidebar)) main {
    grid-column: 1;
    grid-row: 1;
  }

  #main-grid:has(#left-sidebar) #right-sidebar-container[data-active="true"] {
    grid-column: 3;
    grid-row: 1;
  }

  #main-grid:not(:has(#left-sidebar)) #right-sidebar-container[data-active="true"] {
    grid-column: 2;
    grid-row: 1;
  }
}

.tag-plugin.tabs {
  margin: 1em 0;
  border-radius: 0.5rem;
  overflow: hidden;
}
.tag-plugin.tabs .tab-nav {
  display: flex;
  gap: 2px;
  border-bottom: 2px solid var(--primary, oklch(0.5 0.15 var(--hue)));
  padding: 0;
  margin: 0 !important;
}
.tag-plugin.tabs .tab-btn {
  padding: 0.5rem 1rem;
  border: none;
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 500;
  background: transparent;
  color: var(--secondary, oklch(0.5 0.05 var(--hue)));
  border-radius: 0.25rem 0.25rem 0 0;
  transition: all 0.2s;
}
.tag-plugin.tabs .tab-btn:hover {
  background: var(--block-bg, oklch(0.95 0.01 var(--hue)));
  color: var(--primary, oklch(0.5 0.15 var(--hue)));
}
.tag-plugin.tabs .tab-btn.active {
  background: var(--primary, oklch(0.5 0.15 var(--hue)));
  color: white;
}
.tag-plugin.tabs .tab-panel {
  display: none;
  padding: 1rem;
  background: var(--block-bg, oklch(0.97 0.005 var(--hue)));
  border: 1px solid var(--block-border, oklch(0.85 0.02 var(--hue)));
  border-top: none;
  border-radius: 0 0 0.25rem 0.25rem;
}
.tag-plugin.tabs .tab-panel.active {
  display: block;
}

/* ==========================================================================
   移动端目录抽屉
   --------------------------------------------------------------------------
   桌面端的目录在右侧栏里，移动端它会被排到正文、左侧栏之后（order-3），
   也就是页面最底部 —— 读文章时根本翻不到。
   这里把文章页的 #right-sidebar-container 从文档流里拎出来，做成底部抽屉；
   复用同一个 DOM 而不是克隆，是因为 TOC 是 custom element，内部用全局的
   #toc / #toc-inner-wrapper 查询锚点，两份实例会互相抢高亮。
   ========================================================================== */
.mobile-toc-overlay,
.mobile-toc-toggle {
  display: none;
}

@media (max-width: 1023px) {
  /*
     抽屉和遮罩都在 #main-panel（z-30）里，z-index 再高也压不过 z-50 的导航栏，
     所以抽屉打开时把整个面板提到导航栏之上。正文此时被遮罩盖住，不受影响。
  */
  #main-panel:has(#right-sidebar-container[data-toc-open="true"]) {
    z-index: 65;
  }

  /* 显隐由 JS 按当前页是否有目录决定，默认不出现 */
  .mobile-toc-toggle[data-visible="true"] {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    right: 1rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    z-index: 45;
    color: var(--primary);
    font-size: 1.5rem;
    box-shadow: 0 8px 24px -12px oklch(0.5 0.1 var(--hue));
  }

  .mobile-toc-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 55;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }
  .mobile-toc-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  #right-sidebar-container[data-article="true"] {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    top: auto;
    height: 60vh;
    max-height: 60vh;
    z-index: 60;
    padding: 0;
    border-radius: 1.25rem 1.25rem 0 0;
    background: var(--card-bg);
    box-shadow: 0 -10px 34px -16px rgba(0, 0, 0, 0.35);
    transform: translateY(100%);
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
    overflow: hidden;
    order: unset;
  }
  #right-sidebar-container[data-article="true"][data-toc-open="true"] {
    transform: translateY(0);
  }

  /* 顶部把手，暗示可以点遮罩收起 */
  #right-sidebar-container[data-article="true"]::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    left: 50%;
    width: 2.5rem;
    height: 0.25rem;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.15;
    transform: translateX(-50%);
    pointer-events: none;
  }

  /* 抽屉里取消 sticky 与 toc-hide，让目录直接铺满并自行滚动 */
  #right-sidebar-container[data-article="true"] #toc-wrapper {
    height: 100%;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  #right-sidebar-container[data-article="true"] #toc-inner-wrapper {
    position: static;
    top: auto;
    height: 100%;
    max-height: 100%;
    padding: 1.5rem 1rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
  }
  #right-sidebar-container[data-article="true"] #toc > div {
    background: transparent;
    box-shadow: none;
    border-radius: 0;
  }
}
</style>
<script is:inline>
document.addEventListener("click",function(e){
  var b=e.target.closest(".tab-btn");if(!b)return;
  var t=b.closest(".tag-plugin.tabs");if(!t)return;
  t.querySelectorAll(".tab-btn").forEach(function(x){x.classList.remove("active")});
  t.querySelectorAll(".tab-panel").forEach(function(x){x.classList.remove("active")});
  b.classList.add("active");
  var p=t.querySelectorAll(".tab-panel");
  if(p[b.getAttribute("data-tab")])p[b.getAttribute("data-tab")].classList.add("active");
});
</script>

<script>
/* ==========================================================================
   移动端目录抽屉
   --------------------------------------------------------------------------
   监听器挂在 document 上而不是按钮上：#right-sidebar-container 是 swup 容器，
   每次换页内容都会被替换，直接绑在按钮上的监听器会跟着旧节点一起消失。
   ========================================================================== */
const TOC_OPEN_ATTR = "data-toc-open";

function setMobileTocOpen(open: boolean) {
	const container = document.getElementById("right-sidebar-container");
	if (!container) return;
	container.setAttribute(TOC_OPEN_ATTR, String(open));
	document.getElementById("mobile-toc-overlay")?.classList.toggle("is-open", open);
	document.getElementById("mobile-toc-toggle")?.setAttribute("aria-expanded", String(open));

	// 抽屉比正文晚出现，打开时把当前阅读到的条目滚进可视区
	if (!open) return;
	const wrapper = document.getElementById("toc-inner-wrapper");
	const active = document.querySelector("#toc a.visible");
	if (!wrapper || !active) return;
	const delta = active.getBoundingClientRect().top - wrapper.getBoundingClientRect().top;
	wrapper.scrollTo({
		top: Math.max(0, wrapper.scrollTop + delta - wrapper.clientHeight * 0.3),
		behavior: "smooth",
	});
}

/**
 * swup 只替换容器内容、不替换容器本身，所以 #right-sidebar-container 上的
 * data-article 和容器外的目录按钮，换页后都还停在上一页的状态，得手动同步。
 */
function syncMobileTocState() {
	const container = document.getElementById("right-sidebar-container");
	// 用实际的目录锚点判断：#toc-wrapper 在文章页总会渲染，即使这篇文章没有小标题
	const isArticle = !!container?.querySelector("#toc a[href^='#']");
	container?.setAttribute("data-article", String(isArticle));
	document.getElementById("mobile-toc-toggle")?.setAttribute("data-visible", String(isArticle));
	setMobileTocOpen(false);
}

document.addEventListener("click", (event) => {
	const target = event.target;
	if (!(target instanceof Element)) return;

	if (target.closest("#mobile-toc-toggle")) {
		const container = document.getElementById("right-sidebar-container");
		setMobileTocOpen(container?.getAttribute(TOC_OPEN_ATTR) !== "true");
		return;
	}

	if (target.closest("#mobile-toc-overlay")) {
		setMobileTocOpen(false);
		return;
	}

	// 点目录里的锚点后自动收起，否则抽屉会一直盖着正文
	if (target.closest("#right-sidebar-container a[href^='#']")) {
		setMobileTocOpen(false);
	}
});

// 换页前先收起，避免 swup 替换容器内容时抽屉闪一下
document.addEventListener("astro:before-swap", () => setMobileTocOpen(false));
// 换页后重新判断当前页有没有目录
document.addEventListener("astro:page-load", syncMobileTocState);
syncMobileTocState();
</script>

---
import MarkdownIt from "markdown-it";
import { profileConfig, siteConfig } from "../config/site";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

const footerConfig = siteConfig.footer;
const footerLines = footerConfig?.content;
const hasCustomFooter = footerConfig?.enable && footerLines && footerLines.length > 0;
const md = new MarkdownIt({ html: true });
---

{hasCustomFooter
? <div class="card-base py-6 px-6 mt-8 mb-8 flex flex-col items-center justify-center markdown-footer">
    {footerLines!.map((line) => {
        if (line.startsWith("<")) {
            return <div set:html={line} />;
        }
        return <p set:html={md.renderInline(line)} />;
    })}
</div>
: <div class="card-base py-6 px-6 mt-8 mb-8 flex flex-col items-center justify-center">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Furrity</a>
    </div>
</div>
}

<style is:global>
    .markdown-footer a {
        @apply text-[var(--primary)] font-medium transition;
    }
    .markdown-footer p {
        @apply text-center my-2;
        color: rgb(0 0 0 / 0.5);
    }
    .dark .markdown-footer p {
        color: rgb(255 255 255 / 0.5);
    }
    .markdown-footer > div {
        @apply text-center my-2;
        color: rgb(0 0 0 / 0.5);
    }
    .dark .markdown-footer > div {
        color: rgb(255 255 255 / 0.5);
    }
    .markdown-footer #StaticBadge {
        @apply flex flex-wrap justify-center gap-2 my-3;
    }
    .markdown-footer #StaticBadge img {
        @apply h-auto;
    }
</style>

<script>
    // 站点运行时间。
    // 算法与 cdn.245179.xyz/js/runtime.js 完全一致：同样的 +250ms 补偿、
    // 同样的取整顺序、同样的文案与 &nbsp，连秒数用 Math.round 都照搬。
    //
    // 唯一改动是取值方式：原脚本用 getElementById("timeDate")，而页面里有两个
    // footer（桌面 hidden lg:block / 移动 block lg:hidden），两处同名 id 造成重复。
    // getElementById 只返回 DOM 里第一个 —— 也就是桌面那份；手机上它被 hidden 藏着，
    // 所以脚本一直在更新看不见的元素，可见的那份永远停在"载入天数..."。
    // 这里改成 querySelectorAll，两份一起更新。
    const UPTIME_START = new Date("2024/08/31 10:05:30").getTime();

    function pad2(n: number): string {
        return String(n).padStart(2, "0");
    }

    function updateUptime(): void {
        const now = Date.now() + 250;
        const diffSeconds = (now - UPTIME_START) / 1000;
        const diffMinutes = diffSeconds / 60;
        const diffHours = diffMinutes / 60;
        const diffDays = diffHours / 24;

        const dnum = Math.floor(diffDays);
        const hnum = Math.floor(diffHours - 24 * dnum);
        const mnum = Math.floor(diffMinutes - 24 * 60 * dnum - 60 * hnum);
        const snum = Math.round(diffSeconds - 24 * 60 * 60 * dnum - 60 * 60 * hnum - 60 * mnum);

        const daysText = `本站在恶劣的环境中生存了&nbsp${dnum}&nbsp天`;
        const clockText = `${pad2(hnum)}&nbsp小时&nbsp;${pad2(mnum)}&nbsp分&nbsp;${pad2(snum)}&nbsp秒`;

        document.querySelectorAll('[id="timeDate"]').forEach((el) => {
            el.innerHTML = daysText;
        });
        document.querySelectorAll('[id="times"]').forEach((el) => {
            el.innerHTML = clockText;
        });
    }

    updateUptime();
    window.setInterval(updateUptime, 1000);
</script>

---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    right: 1rem
    bottom: 10rem
    z-index: 40
    opacity: 1
    cursor: pointer
    transform: translateX(0)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateX(calc(100% + 2rem))
        opacity: 0
        pointer-events: none
    &:active
        transform: translateX(0) scale(0.9)

/* 移动端：和目录抽屉按钮一起排在右下角，返回顶部叠在它上面 */
@media (max-width: 1023px)
    .back-to-top-btn
        bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px))

</style>

<script is:raw is:inline>
function backToTop() {
	// OverlayScrollbars 接管 body 滚动时，window.scroll 可能无效，
	// 同时滚动 window / html / body，确保一定回到顶部
	var opts = { top: 0, behavior: 'smooth' };
	window.scrollTo(opts);
	if (document.documentElement.scrollTo) document.documentElement.scrollTo(opts);
	if (document.body.scrollTo) document.body.scrollTo(opts);
}

// 按钮横向跟随「文章正文块」（main 栏，正文卡片宽度与之一致）的右缘，
// 而不是整页网格（#main-grid 还包含右侧目录栏）的右缘
function positionBackToTop() {
	var btn = document.getElementById('back-to-top-btn');
	if (!btn) return;

	// 移动端没有右侧栏，按钮直接和目录抽屉按钮对齐在右下角
	if (window.innerWidth < 1024) {
		btn.style.right = '1rem';
		return;
	}

	var content = document.querySelector('#main-grid main') || document.getElementById('main-grid');
	if (!content) return;
	var rect = content.getBoundingClientRect();
	var btnW = btn.offsetWidth || 60;
	// 按钮左缘贴在正文块右缘外侧 0.5rem
	var left = rect.right + 8;
	// 视口不够宽时收回，避免按钮跑出屏幕
	var maxLeft = window.innerWidth - btnW - 12;
	if (left > maxLeft) left = maxLeft;
	btn.style.right = window.innerWidth - left - btnW + 'px';
}

window.__backToTopPosition = positionBackToTop;
positionBackToTop();

// swup 会重复执行这段内联脚本，用全局守卫避免重复注册监听器
if (!window.__backToTopInit) {
	window.__backToTopInit = true;
	window.addEventListener('resize', positionBackToTop);
	document.addEventListener('astro:page-load', positionBackToTop);
	// 正文栏宽度可能随右侧目录出现/消失、字体加载而变化，用 ResizeObserver 兜底
	if (window.ResizeObserver) {
		new ResizeObserver(positionBackToTop).observe(document.documentElement);
	}
	if (document.fonts && document.fonts.ready) {
		document.fonts.ready.then(positionBackToTop);
	}
}
</script>

---
const checklistFirst = [
	{ id: "dom:parse", label: "DOM 解析完成" },
	{ id: "layout:render", label: "页面布局渲染" },
	{ id: "swup:enable", label: "SWUP 引擎初始化" },
	{ id: "third-party", label: "第三方组件就绪" },
	{ id: "window:load", label: "资源加载完成" },
];
---

<div class="spinner" id="page-loader">
	<span class="loader-text" id="loader-percent">0%</span>
	<div class="loader" style="--width: 0%;"></div>
	<ul class="loader-checklist" id="loader-checklist">
		{checklistFirst.map((item) => (
			<li class="running" data-check={item.id}>
				<span class="ck-label">{item.label}</span>
				<span class="ck-meta">—</span>
				<span class="ck-sub"></span>
			</li>
		))}
	</ul>
	<span class="loader-warn" id="loader-warn" hidden>⚠️ 已等待 5 秒，某项可能卡住</span>
	<span class="loader-text-below" id="loader-close">不想等待可以点我关掉</span>
	<span class="loader-tips">Tips：非卡住不建议关闭，以确保Swup正常运行</span>
</div>

<style is:global>
	#page-loader {
		position: fixed; inset: 0; z-index: 9999;
		display: flex; flex-direction: column;
		align-items: center; justify-content: center;
		background: oklch(0.96 0.01 var(--hue, 250) / 0.55);
		backdrop-filter: blur(2px);
		transition: opacity 0.3s;
	}
	#page-loader.hide { opacity: 0; pointer-events: none; }
	#page-loader .loader {
		width: 240px; height: 4px;
		background: oklch(0.85 0.02 var(--hue, 250));
		border-radius: 2px; overflow: hidden;
		margin-bottom: 14px;
	}
	#page-loader .loader::after {
		content: ""; display: block; height: 100%;
		width: var(--width, 0%); background: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
		border-radius: 2px; transition: width 0.16s linear;
	}
	#page-loader .loader-text {
		font-size: 15px; color: oklch(0.45 0.02 var(--hue, 250));
		margin-bottom: 8px;
	}

	/* ---------- 清单 ---------- */
	#page-loader .loader-checklist {
		list-style: none; padding: 0; margin: 0 0 12px;
		width: min(420px, calc(100vw - 32px));
		display: flex; flex-direction: column; gap: 6px;
		/* 不用 40vh 硬卡：内容本身有界（约 340px），硬卡只会在小屏/手机横屏把面板切掉。
		   改成允许收缩 + 宽松上限 —— 高度够就完整显示，不够就自己内部滚动，
		   而不是把整个 overlay 顶出视口（横屏 390px 高时就会那样）。 */
		flex: 0 1 auto; min-height: 0;
		max-height: 70vh; overflow-y: auto;
		font-size: 13px; color: oklch(0.45 0.02 var(--hue, 250));
	}
	#page-loader .loader-checklist li {
		display: flex; flex-wrap: wrap; align-items: flex-start;
		column-gap: 6px; row-gap: 2px;
		transition: color 0.25s;
	}
	/* 图标列固定 12px（1em = 自身 font-size），所有状态同宽，文字永不左右跳 */
	#page-loader .loader-checklist li::before {
		content: "○";
		flex: 0 0 1em;
		font-size: 12px; line-height: 20px; text-align: center;
		color: oklch(0.6 0.02 var(--hue, 250));
	}
	#page-loader .loader-checklist li .ck-label {
		flex: 1 1 auto; min-width: 0;
		line-height: 20px;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	#page-loader .loader-checklist li .ck-meta {
		flex: 0 0 auto;
		font-size: 11px; line-height: 20px;
		font-variant-numeric: tabular-nums;
		color: oklch(0.6 0.02 var(--hue, 250));
	}
	#page-loader .loader-checklist li .ck-sub {
		flex: 1 0 100%; box-sizing: border-box;
		padding-left: 18px;
		font-size: 11px; line-height: 16px;
		color: oklch(0.58 0.02 var(--hue, 250));
	}
	#page-loader .loader-checklist li .ck-sub:empty { display: none; }

	/* 进行中：与 .done / .warn 同特异性，靠源码顺序决定优先级 */
	#page-loader .loader-checklist li.running {
		color: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
	}
	#page-loader .loader-checklist li.running::before {
		content: "";
		box-sizing: border-box;
		width: 12px; height: 12px; margin-top: 4px;
		border: 2px solid currentColor;
		border-top-color: transparent;
		border-radius: 50%;
		animation: ck-spin 0.8s linear infinite;
	}
	#page-loader .loader-checklist li.running .ck-meta { color: inherit; }

	#page-loader .loader-checklist li.done { color: oklch(0.4 0.04 var(--hue, 250)); }
	#page-loader .loader-checklist li.done::before {
		content: "✓"; color: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
	}

	/* 警告：必须排在 .running 之后，且要显式清掉转圈的盒子属性 */
	#page-loader .loader-checklist li.warn { color: oklch(0.55 0.13 var(--warn-hue, 30)); }
	#page-loader .loader-checklist li.warn::before {
		content: "!";
		width: auto; height: auto; margin-top: 0;
		border: 0; border-radius: 0;
		animation: none;
		font-weight: 700;
		color: oklch(0.55 0.13 var(--warn-hue, 30));
	}
	#page-loader .loader-checklist li.warn .ck-meta { color: inherit; }

	@keyframes ck-spin { to { transform: rotate(360deg); } }
	/* 降低动效：不只是转圈，进度条的爬升和过渡也要停 —— 否则每 100ms 硬跳一格，
	   比平滑更刺眼。JS 侧同步把 CREEP_RATIO 置 0 并跳过平滑跟随。 */
	@media (prefers-reduced-motion: reduce) {
		#page-loader .loader-checklist li.running::before {
			animation: none; border-top-color: currentColor; opacity: 0.4;
		}
		#page-loader .loader::after { transition: none; }
	}

	/* ---------- 资源明细（挂在 window:load 那一条下面） ---------- */
	#page-loader .ck-res {
		flex: 1 0 100%; box-sizing: border-box;
		padding-left: 18px;
	}
	#page-loader .ck-res-head {
		display: flex; justify-content: space-between; gap: 8px;
		font-size: 11px; line-height: 16px;
		color: oklch(0.55 0.02 var(--hue, 250));
	}
	#page-loader .ck-res-log {
		max-height: 120px; overflow-y: auto;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 11px; line-height: 16px;
		color: oklch(0.5 0.02 var(--hue, 250));
	}
	#page-loader .ck-res-row {
		display: grid;
		grid-template-columns: 5.4em 3.2em minmax(0, 1fr) 5.4em 4.4em 2.6em;
		column-gap: 6px;
	}
	/* 待加载的行没有体积/耗时，只要两列 */
	#page-loader .ck-res-row-lite {
		grid-template-columns: 3.2em minmax(0, 1fr);
		column-gap: 8px;
	}
	/* 窄屏：六列在手机上光固定宽度就占掉 261px（5.4+3.2+5.4+4.4+2.6em 加 5×6px 间距），
	   390px 屏只剩 79px 给文件名、360px 剩 49px、320px 只剩 9px —— 最有用的一列等于消失。
	   改成两行：文件名独占第一行，其余字段挪到第二行，一个都不丢。 */
	@media (max-width: 480px) {
		#page-loader .ck-res-row {
			grid-template-columns: 4.6em minmax(0, 1fr) auto auto;
			grid-template-areas:
				"t    name name name"
				"kind size dur  flag";
			row-gap: 0;
		}
		#page-loader .ck-res-row > .ck-res-t { grid-area: t; }
		#page-loader .ck-res-row > .ck-res-kind { grid-area: kind; }
		#page-loader .ck-res-row > .ck-res-name { grid-area: name; }
		#page-loader .ck-res-row > .ck-res-size { grid-area: size; }
		#page-loader .ck-res-row > .ck-res-dur { grid-area: dur; }
		#page-loader .ck-res-row > .ck-res-flag { grid-area: flag; }
		/* 待加载的行本来就是"类型 + 文件名"，保持单行 */
		#page-loader .ck-res-row-lite {
			grid-template-columns: 3.2em minmax(0, 1fr);
			grid-template-areas: "kind name";
		}
	}
	#page-loader .ck-res-row > span {
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	#page-loader .ck-res-t { color: oklch(0.6 0.02 var(--hue, 250)); }
	#page-loader .ck-res-size,
	#page-loader .ck-res-dur { text-align: right; }
	#page-loader .ck-res-flag { font-size: 10px; text-align: right; }
	#page-loader .ck-res-div {
		margin-top: 2px; padding-top: 2px;
		border-top: 1px solid oklch(0.88 0.02 var(--hue, 250));
		font-size: 11px; line-height: 16px;
		color: oklch(0.62 0.02 var(--hue, 250));
		cursor: help;
	}
	#page-loader .ck-res-pending { opacity: 0.55; }
	#page-loader .ck-res-more,
	#page-loader .ck-res-sum {
		font-size: 11px; line-height: 16px;
		color: oklch(0.6 0.02 var(--hue, 250));
	}
	#page-loader .ck-res-sum { padding-top: 2px; }

	#page-loader .loader-warn {
		font-size: 12px; color: oklch(0.55 0.13 var(--warn-hue, 30));
		margin-bottom: 8px;
	}
	#page-loader .loader-text-below {
		font-size: 13px; color: oklch(0.5 0.04 var(--hue, 250));
		cursor: pointer; border-bottom: 1px solid transparent;
		transition: border-color 0.2s;
		/* 触摸目标：13px 高的一行字在手机上很难点中。
		   用 padding 撑到约 29px，负 margin 抵掉，视觉布局不变；
		   下方只多出 4px，免得吃掉紧跟其后的 Tips 那一行。 */
		padding: 12px 12px 4px;
		margin: -12px -12px -4px;
	}
	#page-loader .loader-text-below:hover {
		border-bottom-color: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
	}
	#page-loader .loader-tips {
		font-size: 12px; color: oklch(0.55 0.02 var(--hue, 250));
		margin-top: 6px;
	}
</style>

<script is:inline>
	(function () {
		if (window.__pageLoaderInit) return;
		window.__pageLoaderInit = true;

		var loader = document.getElementById("page-loader");
		if (!loader) return;
		var percentEl = loader.querySelector("#loader-percent");
		var listEl = loader.querySelector("#loader-checklist");
		var barEl = loader.querySelector(".loader");
		var warnEl = document.getElementById("loader-warn");

		var checklist = [];
		var checkedCount = 0;
		var hiddenByUser = false;

		// 进度条状态：真实档位 + 档位内的时间爬升，再平滑跟随（见 updateBar）
		var progShown = 0;      // 当前显示值
		var stepAt = 0;         // 进入当前档位的时刻
		var CREEP_MS = 900;     // 爬升时间常数：越大越慢
		var CREEP_RATIO = 0.85; // 档位内最多爬到间距的多少；设 0 即退回"只在完成时跳档"

		// 降低动效：不爬升、也不平滑跟随，进度条只反映真实档位（配合 CSS 的 transition: none）
		var REDUCED = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
		if (REDUCED) CREEP_RATIO = 0;

		var warnTimers = [];
		var tickTimer = null;

		var resObserver = null;
		var resEntries = [];
		var resCursor = 0;
		var resDirty = false;
		var resTotal = 0;
		var resFlagged = 0;
		var resPanel = null;

		var RES_DONE_MAX = 2;   // 日志上半：只留最近完成的 2 条
		var RES_PEND_MAX = 3;   // 日志下半：只列待加载的前 3 条
		var RES_BUFFER = 600;   // Resource Timing 缓冲区

		/* ---------------- 格式化 ---------------- */

		function fmtOffset(ms) {
			if (ms < 1000) return "+" + Math.round(ms) + "ms";
			if (ms < 10000) return "+" + (ms / 1000).toFixed(2) + "s";
			return "+" + (ms / 1000).toFixed(1) + "s";
		}

		function fmtDuration(ms) {
			if (ms < 1000) return Math.round(ms) + "ms";
			return (ms / 1000).toFixed(2) + "s";
		}

		function fmtBytes(n) {
			if (!n) return "—";
			if (n < 1024) return n + " B";
			if (n < 1048576) return (n / 1024).toFixed(1) + " KB";
			return (n / 1048576).toFixed(2) + " MB";
		}

		/* ---------------- 真实时刻 ---------------- */
		// performance.now() 本身就是相对 navigationStart 的偏移，
		// 和 Resource Timing 的 startTime 同一坐标系，所以两处数字可以横向对比。
		function navEntry() {
			var list = performance.getEntriesByType("navigation");
			return list && list[0] ? list[0] : null;
		}

		// 优先取 Navigation Timing 记录的真实时刻；取不到才用"我发现它的那一刻"
		function stampFor(id) {
			var nav = navEntry();
			if (nav) {
				if (id === "dom:parse" && nav.domInteractive) return nav.domInteractive;
				if (id === "window:load" && nav.loadEventEnd) return nav.loadEventEnd;
			}
			return performance.now();
		}

		/* ---------------- 每条的实时数据 ---------------- */

		var LIVE = {
			"dom:parse": function () {
				var nav = navEntry();
				if (!nav) return "";
				var out = [];
				if (nav.domInteractive) out.push("domInteractive " + Math.round(nav.domInteractive) + "ms");
				if (nav.domContentLoadedEventEnd) out.push("DCL " + Math.round(nav.domContentLoadedEventEnd) + "ms");
				return out.join(" · ");
			},
			"layout:render": function () {
				var out = [document.getElementsByTagName("*").length.toLocaleString() + " 节点"];
				// Paint Timing 在 Safari 上没有，取不到就整段省略，不要显示 NaN
				var fcp = performance.getEntriesByName("first-contentful-paint")[0];
				if (fcp) out.push("FCP " + Math.round(fcp.startTime) + "ms");
				return out.join(" · ");
			},
			"swup:enable": function (item) {
				return item.done ? "" : "等待 swup:enable 事件";
			},
			"third-party": function () {
				var out = [];
				var diagrams = document.querySelectorAll(".mermaid");
				if (diagrams.length) {
					var ready = 0;
					for (var i = 0; i < diagrams.length; i++) {
						if (diagrams[i].querySelector("svg")) ready++;
					}
					out.push("mermaid " + ready + "/" + diagrams.length);
				}
				if (document.querySelector('[id^="music-widget-"]')) out.push("音乐组件已挂载");
				return out.join(" · ");
			},
			"window:load": function () {
				return ""; // 这一条的实时数据就是下面那块资源面板
			},
		};

		/* ---------------- 资源采集 ---------------- */

		function shortName(raw) {
			var cut = raw.split("?")[0]; // Astro 的 ?v= 之类要去掉，否则一行全是哈希
			var u;
			try { u = new URL(cut); } catch (e) { return cut; }
			if (u.protocol !== "http:" && u.protocol !== "https:") return u.protocol + "…";
			var file = u.pathname.split("/").pop() || u.pathname;
			if (u.origin === location.origin) return file;
			return u.hostname.replace(/^www\./, "") + "/…/" + file;
		}

		function collect(e) {
			var raw = e.name || "";
			// data:/blob: 是内联的，没有网络行为，列出来只会淹没有效信息
			if (raw.indexOf("data:") === 0 || raw.indexOf("blob:") === 0) return;

			var cross = true;
			try { cross = new URL(raw).origin !== location.origin; } catch (err) { /* 保持 true */ }

			var size = e.transferSize || 0;
			resEntries.push({
				at: e.startTime,
				kind: e.initiatorType || "other",
				name: raw,
				short: shortName(raw),
				size: size,
				dur: e.duration,
				// 体积为 0 有两种原因，靠 URL 同源判断能区分开
				flag: size ? "" : (cross ? "跨域" : "缓存"),
			});
			resTotal += size;
			if (!size) resFlagged++;
			resDirty = true;
		}

		// 默认缓冲区只有 250 条，超了会静默丢弃 —— 必须在最早期调大
		try {
			if (typeof performance.setResourceTimingBufferSize === "function") {
				performance.setResourceTimingBufferSize(RES_BUFFER);
			}
		} catch (e) { /* 不支持就算了，主流程不受影响 */ }

		if (typeof PerformanceObserver === "function") {
			try {
				resObserver = new PerformanceObserver(function (list) {
					var items = list.getEntries();
					for (var i = 0; i < items.length; i++) collect(items[i]);
				});
				// buffered:true —— 脚本跑起来之前就下完的资源也要补回来
				resObserver.observe({ type: "resource", buffered: true });
			} catch (e) {
				resObserver = null; // 老 Safari 走到轮询兜底
			}
		}

		function pollResources() {
			if (resObserver) return;
			var all = performance.getEntriesByType("resource");
			for (var i = resCursor; i < all.length; i++) collect(all[i]);
			resCursor = all.length;
		}

		/* ---------------- "待加载"从哪来 ---------------- */
		// 键用「origin + pathname」：Astro 的 ?v=哈希、#片段、
		// 以及大部分重定向都不会让同一个资源被算成两个。
		function resKey(url) {
			try {
				var u = new URL(url, location.href);
				return u.origin + u.pathname;
			} catch (e) {
				return url;
			}
		}

		// 文档里"已声明、且浏览器确实会为它发请求"的资源。
		// 刻意排除三类候选列表 / 延迟加载，否则会列出一堆首屏根本不会下载的东西：
		//   - img[loading=lazy]：要等滚动到视口
		//   - link[rel=prefetch]：下一次导航才用
		//   - source[src]：和 srcset 一样是候选列表，浏览器只挑一个
		function declaredResources() {
			var out = [];
			var seen = {};
			function add(url, kind) {
				if (!url) return;
				var cut = url.split("#")[0];
				if (cut.indexOf("data:") === 0 || cut.indexOf("blob:") === 0) return;
				var k = resKey(cut);
				if (seen[k]) return;
				seen[k] = true;
				out.push({ name: cut, kind: kind });
			}

			var images = document.querySelectorAll("img");
			for (var i = 0; i < images.length; i++) {
				var img = images[i];
				if ((img.getAttribute("loading") || "").toLowerCase() === "lazy") continue;
				add(img.currentSrc || img.src, "img");
			}

			var scripts = document.querySelectorAll("script[src]");
			for (var j = 0; j < scripts.length; j++) add(scripts[j].src, "js");

			var links = document.querySelectorAll("link[href]");
			for (var m = 0; m < links.length; m++) {
				var rel = (links[m].getAttribute("rel") || "").toLowerCase();
				if (rel === "stylesheet") add(links[m].href, "css");
				else if (rel === "preload" || rel === "modulepreload" ||
					rel === "icon" || rel === "apple-touch-icon") add(links[m].href, "link");
			}

			var media = document.querySelectorAll("video[src], audio[src]");
			for (var n = 0; n < media.length; n++) add(media[n].src, "media");

			return out;
		}

		// 声明过 − 已经有 Resource Timing 记录 = 还没下完的。
		// 每次渲染都重算：4 次 querySelectorAll 最多跑 10 次/秒，代价可以忽略；
		// 而加缓存会让计数滞后于资源实际完成的时刻 —— 那正是这块面板要展示的东西。
		function pendingResources() {
			var done = {};
			for (var i = 0; i < resEntries.length; i++) done[resKey(resEntries[i].name)] = true;

			var declared = declaredResources();
			var out = [];
			for (var j = 0; j < declared.length; j++) {
				if (!done[resKey(declared[j].name)]) out.push(declared[j]);
			}
			return out;
		}

		/* ---------------- 资源面板渲染 ---------------- */

		function cell(cls, text) {
			var s = document.createElement("span");
			s.className = cls;
			s.textContent = text;
			return s;
		}

		function resRow(r) {
			var row = document.createElement("div");

			// 待加载的项没有体积/耗时可言，只给"类型 + 文件名"两列
			if (r.at == null) {
				row.className = "ck-res-row ck-res-row-lite ck-res-pending";
				row.appendChild(cell("ck-res-kind", r.kind));
				var liteName = cell("ck-res-name", shortName(r.name));
				liteName.title = r.name;
				row.appendChild(liteName);
				return row;
			}

			var name = cell("ck-res-name", shortName(r.name));
			name.title = r.name;
			row.className = "ck-res-row";
			row.appendChild(cell("ck-res-t", fmtOffset(r.at)));
			row.appendChild(cell("ck-res-kind", r.kind));
			row.appendChild(name);
			row.appendChild(cell("ck-res-size", fmtBytes(r.size)));
			row.appendChild(cell("ck-res-dur", fmtDuration(r.dur)));
			row.appendChild(cell("ck-res-flag", r.flag));
			return row;
		}

		function renderRes() {
			if (!resPanel) return;
			var log = resPanel.log;
			// 只在贴底时自动跟随，用户手动往上翻就不抢滚动条
			var stick = log.scrollHeight - log.scrollTop - log.clientHeight < 24;
			var frag = document.createDocumentFragment();

			// 上半：最近完成的 2 条
			var doneStart = Math.max(0, resEntries.length - RES_DONE_MAX);
			if (doneStart > 0) {
				var moreDone = document.createElement("div");
				moreDone.className = "ck-res-more";
				moreDone.textContent = "…还有 " + doneStart + " 项已完成";
				frag.appendChild(moreDone);
			}
			for (var i = doneStart; i < resEntries.length; i++) {
				frag.appendChild(resRow(resEntries[i]));
			}

			// 下半：待加载的前 3 条。这里不再重复总数 —— 分隔行已经说全了，
			// 多一行会让日志区超出 120px 的高度预算。
			var pending = pendingResources();
			if (pending.length) {
				var divider = document.createElement("div");
				divider.className = "ck-res-div";
				divider.textContent = "待加载 " + pending.length + " 项";
				divider.title = "文档里已声明、还没出现在 Resource Timing 里的资源" +
					"（不含 loading=lazy 与 rel=prefetch）。动态 import() 的 chunk、" +
					"srcset 被选中的变体不在声明里，所以这是下界估计。";
				frag.appendChild(divider);

				var shown = Math.min(pending.length, RES_PEND_MAX);
				for (var j = 0; j < shown; j++) {
					frag.appendChild(resRow({
						at: null, kind: pending[j].kind, name: pending[j].name, size: 0, dur: null,
					}));
				}
			}

			log.textContent = "";
			log.appendChild(frag);
			if (stick) log.scrollTop = log.scrollHeight;

			resPanel.stat.textContent = resEntries.length + " 项 · " + fmtBytes(resTotal) +
				(resFlagged ? " · " + resFlagged + " 项无体积数据" : "");
		}

		function buildResPanel(li) {
			var box = document.createElement("div");
			box.className = "ck-res";

			var head = document.createElement("div");
			head.className = "ck-res-head";
			var title = document.createElement("span");
			title.textContent = "资源明细";
			var stat = document.createElement("span");
			stat.className = "ck-res-stat";
			stat.textContent = "0 项";
			head.appendChild(title);
			head.appendChild(stat);

			var log = document.createElement("div");
			log.className = "ck-res-log";
			var sum = document.createElement("div");
			sum.className = "ck-res-sum";
			sum.hidden = true;

			box.appendChild(head);
			box.appendChild(log);
			box.appendChild(sum);
			li.appendChild(box);

			resPanel = { stat: stat, log: log, sum: sum, sumShown: false };
		}

		// 按类型汇总，体积从大到小 —— 一眼看出体积被谁吃掉了
		function finishResPanel() {
			if (!resPanel || resPanel.sumShown) return;
			resPanel.sumShown = true;

			var by = {};
			var order = [];
			for (var i = 0; i < resEntries.length; i++) {
				var t = resEntries[i].kind;
				if (!by[t]) { by[t] = { n: 0, size: 0 }; order.push(t); }
				by[t].n++;
				by[t].size += resEntries[i].size;
			}
			order.sort(function (a, b) { return by[b].size - by[a].size; });

			var parts = order.map(function (t) {
				return t + " ×" + by[t].n + " " + fmtBytes(by[t].size);
			});
			if (resFlagged) parts.push(resFlagged + " 项无体积数据");

			resPanel.sum.textContent = parts.join(" · ");
			resPanel.sum.hidden = false;
		}

		/* ---------------- 清单渲染 ---------------- */

		// 5 行是服务端渲染好的（就在上面的 <ul> 里），这里只取回引用。
		// 以前是等 DOMContentLoaded 才用 createElement 造出来 —— 而 head 里的
		// 样式表和脚本那时早就开始下载了，于是"资源在下、界面还是空的"。
		function adoptChecklist() {
			checklist = [];
			resPanel = null;
			if (!listEl) return;
			var lis = listEl.children;
			for (var i = 0; i < lis.length; i++) {
				var li = lis[i];
				var item = {
					id: li.getAttribute("data-check"),
					el: li,
					metaEl: li.querySelector(".ck-meta"),
					noteEl: li.querySelector(".ck-sub"),
					done: false,
				};
				checklist.push(item);
				if (item.id === "window:load") buildResPanel(li);
			}
		}

		function updateNote(item) {
			if (!item.noteEl) return;
			var fn = LIVE[item.id];
			if (!fn) return;
			var text = fn(item) || "";
			// 内容没变就不写 DOM —— tick 每秒跑 10 次，没必要反复碰它
			if (item.noteEl.textContent !== text) item.noteEl.textContent = text;
		}

		/* ---------------- 心跳 ---------------- */

		function tick() {
			var now = performance.now();
			pollResources();
			updateBar(now);
			for (var i = 0; i < checklist.length; i++) {
				var item = checklist[i];
				if (item.done) continue;
				if (item.metaEl) item.metaEl.textContent = fmtOffset(now);
				updateNote(item);
			}
			if (resDirty) {
				resDirty = false;
				renderRes();
			}
		}

		function startTick() {
			if (!tickTimer) tickTimer = setInterval(tick, 100);
		}

		function stopTick() {
			if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
		}

		/* ---------------- 状态推进 ---------------- */

		function setProgress(p) {
			if (barEl) barEl.style.setProperty("--width", p + "%");
			if (percentEl) percentEl.textContent = Math.round(p) + "%";
		}

		// 进度条不再"只在档位完成时硬跳"：
		//   真实档位 base + 档位内随时间向上界逼近的爬升 = 目标值，
		//   显示值再朝目标平滑跟随（每 100ms 一步，CSS 再补 0.16s），连起来就是连续流动。
		// 爬升封顶在间距的 CREEP_RATIO，所以它永远追不上下一个真实档位 ——
		// 每次真的完成仍会看到一次干净的推进，而不是提前停在 20% 一动不动。
		function updateBar(now) {
			var total = checklist.length || 1;
			var base = (checkedCount / total) * 100;
			var target = 100;
			var k = 0.2;    // 平滑跟随系数
			var snap = 0.2; // 差值小于这个就直接对齐，避免无限逼近却永远到不了
			if (checkedCount < total) {
				var gap = 100 / total;
				target = base + gap * CREEP_RATIO * (1 - Math.exp(-(now - stepAt) / CREEP_MS));
			} else {
				// 全部完成：loader 还有 400ms 就隐藏，用更大的系数和对齐阈值，
				// 保证渐隐之前这条一定是满的
				k = 0.6;
				snap = 2;
			}
			if (REDUCED) {
				progShown = target; // 不做平滑，直接对齐（CSS 里 transition 也关了）
			} else {
				progShown += (target - progShown) * k;
				if (target - progShown < snap) progShown = target;
			}
			setProgress(progShown);
		}

		function resetProgress(now) {
			progShown = 0;
			stepAt = now;
			setProgress(0);
		}

		function warnOnStuck(id, seconds) {
			var t = setTimeout(function () {
				var item = checklist.find(function (x) { return x.id === id; });
				if (!item || item.done) return;
				item.warn = true;
				if (item.el) item.el.classList.add("warn");
				if (warnEl) warnEl.hidden = false;
			}, (seconds || 5) * 1000);
			warnTimers.push(t);
		}

		function clearWarnTimers() {
			warnTimers.forEach(function (t) { clearTimeout(t); });
			warnTimers = [];
			if (warnEl) warnEl.hidden = true;
		}

		function check(name) {
			var item = checklist.find(function (x) { return x.id === name; });
			if (!item || item.done) return;
			item.done = true;
			item.at = stampFor(name);
			if (item.el) {
				item.el.classList.remove("running");
				if (item.warn) {
					item.warn = false;
					item.el.classList.remove("warn");
				}
				item.el.classList.add("done");
			}
			if (item.metaEl) item.metaEl.textContent = fmtOffset(item.at);
			updateNote(item);
			checkedCount++;
			stepAt = performance.now(); // 重置档位内爬升
			updateBar(stepAt);
			if (item.id === "window:load") finishResPanel();
			if (checkedCount === checklist.length) {
				clearWarnTimers();
				scheduleHide();
			}
		}

		function hideLoader() {
			loader.classList.add("hide");
			stopTick();
			clearWarnTimers();
			// 面板不会再出现，观察者留着就是白占资源
			// （若将来让 loader 在 swup 切页时也显示，必须重建观察者并按时戳过滤，
			//   否则 buffered:true 会把整份历史重放一遍，导致重复计入）
			if (resObserver) { resObserver.disconnect(); resObserver = null; }
			checklist = [];
			checkedCount = 0;
			resEntries = [];
			resCursor = 0;
			resTotal = 0;
			resFlagged = 0;
			resPanel = null;
		}

		var hideTimer = null;
		function scheduleHide() {
			if (hideTimer) clearTimeout(hideTimer);
			hideTimer = setTimeout(hideLoader, 400);
		}

		function showSession() {
			if (hiddenByUser) return;
			if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
			clearWarnTimers();
			checkedCount = 0;
			// markup 的初始状态就是"全部进行中"，这里只是把它归位
			checklist.forEach(function (item) {
				item.done = false;
				item.warn = false;
				item.at = null;
				if (!item.el) return;
				item.el.className = "running";
				if (item.metaEl) item.metaEl.textContent = "—";
				if (item.noteEl) item.noteEl.textContent = "";
			});
			resetProgress(performance.now());
			loader.classList.remove("hide");
		}

		/* ---------------- 关闭 ---------------- */

		var closeEl = document.getElementById("loader-close");
		if (closeEl) {
			closeEl.addEventListener("click", function (e) {
				e.stopPropagation();
				hiddenByUser = true;
				hideLoader();
			});
		}

		/* ---------------- 第三方组件 ---------------- */

		function thirdPartyPending() {
			// mermaid 图表必须画完 svg
			var mermaid = document.querySelector(".mermaid");
			if (mermaid && !mermaid.querySelector("svg")) return true;
			// 音乐组件是同步挂载的，外壳在 DOM 里就算就绪 —— 绝不等 meting 的网络请求
			return false;
		}

		function waitForThirdParty(targetId) {
			var hasMermaid = !!document.querySelector(".mermaid");
			var hasMusic = !!document.querySelector('[id^="music-widget-"]');
			if (!hasMermaid && !hasMusic) { check(targetId); return; }
			if (!hasMermaid) { check(targetId); return; }
			warnOnStuck(targetId, 5);
			var interval = setInterval(function () {
				if (thirdPartyPending()) return;
				clearInterval(interval);
				check(targetId);
			}, 300);
		}

		/* ---------------- 首屏 ---------------- */

		function startFirstLoad() {
			showSession();

			// 脚本现在在解析阶段就跑起来了，所以"DOM 解析完成"得等到真的解析完，
			// 不能再像以前那样一上来就勾掉（以前脚本本身是等 DOMContentLoaded 才执行的）
			if (document.readyState === "complete") {
				// 脚本来得太晚（组件被放到 body 末尾之类）：这几步都已经过去了
				check("dom:parse");
				check("layout:render");
				check("window:load");
				waitForThirdParty("third-party");
			} else {
				// mermaid 图表和音乐组件都在 loader 之后的 markup 里，所以"第三方组件"
				// 必须等 DOM 解析完再判断 —— 解析到一半就判断只会看到"一个都没有"，
				// 然后立刻误勾成完成
				var afterDomReady = function () {
					check("dom:parse");
					waitForThirdParty("third-party");
				};
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", afterDomReady);
				} else {
					afterDomReady(); // interactive：解析已结束，只是还没派发 DCL
				}

				var markLayout = function () { check("layout:render"); };
				requestAnimationFrame(markLayout);
				setTimeout(markLayout, 150); // rAF 在后台标签页/无头浏览器会被节流，双保险

				window.addEventListener("load", function () { check("window:load"); });
				// window:load 给到 8 秒：慢速移动网络下 5 秒很正常，
				// 用 5 秒会让访客在正常加载时也看到"某项可能卡住"
				warnOnStuck("window:load", 8);
			}

			document.addEventListener("swup:enable", function () { check("swup:enable"); });
			// Swup 是懒初始化的（loadOnIdle），5 秒还没起来就标成卡住，别假装成功
			warnOnStuck("swup:enable", 5);

			resDirty = true; // 首帧就把"待加载"那半截画出来，别等第一个资源下完
			startTick();
			tick();
		}

		// 立刻开跑，不再等 DOMContentLoaded —— loader 的 markup 就在本脚本上方，
		// 解析到这里时它已经在 DOM 里了
		adoptChecklist();
		startFirstLoad();
	})();
</script>

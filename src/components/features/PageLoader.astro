---
import { siteConfig } from "@/config/site";
---

<!--
    首屏遮罩：只告诉访客"是谁、还要多久、能不能跳过"。
    window:load 一到就收，兜底 900ms —— 遮罩多停 1 秒，LCP 就整体后移 1 秒。
-->
<div class="spinner" id="page-loader" style="position:fixed;inset:0;z-index:9999;" role="status" aria-live="polite" aria-label="正在加载页面">
	<div class="loader-brand">
		<span class="loader-dot" aria-hidden="true"></span>
		<span class="loader-title">{siteConfig.title}</span>
	</div>

	<div class="loader" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
		<span class="loader-bar"></span>
	</div>

	<div class="loader-row">
		<span class="loader-percent" id="loader-percent">0%</span>
		<span class="loader-status" id="loader-status">正在准备页面…</span>
	</div>

	<button type="button" class="loader-skip" id="loader-close">跳过</button>
</div>

<style is:global>
	#page-loader {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		/* 遮罩最贵的一笔开销就是这层全屏 blur；低端机掉帧先动这个数字 */
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		background: oklch(0.96 0.01 var(--hue, 250) / 0.55);
		transition: opacity 0.2s ease;
		/* 定位同时写在内联 style 里：外链 CSS 到达前它就已经是 fixed，
		   永远不会以"文档流第一块内容"的身份参与布局 */
		contain: layout;
	}

	/* 深色主题下不能还是那块亮底，否则暗色用户会先看到一记白闪 */
	:root.dark #page-loader {
		background: oklch(0.18 0.014 var(--hue, 250) / 0.62);
	}

	#page-loader.hide {
		opacity: 0;
		pointer-events: none;
	}

	#page-loader .loader-brand {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: oklch(0.42 0.02 var(--hue, 250));
	}

	:root.dark #page-loader .loader-brand {
		color: oklch(0.82 0.02 var(--hue, 250));
	}

	#page-loader .loader-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
		animation: loader-pulse 1.2s ease-in-out infinite;
	}

	@keyframes loader-pulse {
		0%,
		100% {
			opacity: 0.3;
			transform: scale(0.8);
		}
		50% {
			opacity: 1;
			transform: scale(1);
		}
	}

	#page-loader .loader {
		width: min(240px, calc(100vw - 96px));
		height: 4px;
		border-radius: 2px;
		overflow: hidden;
		background: oklch(0.86 0.02 var(--hue, 250));
	}

	:root.dark #page-loader .loader {
		background: oklch(0.32 0.02 var(--hue, 250));
	}

	#page-loader .loader-bar {
		display: block;
		width: 0%;
		height: 100%;
		border-radius: 2px;
		background: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
		transition: width 0.12s linear;
	}

	#page-loader .loader-row {
		display: flex;
		align-items: baseline;
		gap: 8px;
		/* 高度写死：文案每变一次，下面"跳过"按钮就不会被顶得跳一格 */
		min-height: 18px;
		font-size: 12px;
		line-height: 18px;
		font-variant-numeric: tabular-nums;
		color: oklch(0.52 0.02 var(--hue, 250));
	}

	:root.dark #page-loader .loader-row {
		color: oklch(0.7 0.02 var(--hue, 250));
	}

	#page-loader .loader-percent {
		font-weight: 700;
		color: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
	}

	#page-loader .loader-skip {
		position: absolute;
		bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
		/* padding 撑出触摸目标，13px 的一行字在手机上点不中 */
		padding: 10px 18px;
		border: 0;
		border-radius: 9999px;
		background: none;
		font-size: 12px;
		color: oklch(0.55 0.02 var(--hue, 250));
		cursor: pointer;
		transition: color 0.2s, background-color 0.2s;
	}

	:root.dark #page-loader .loader-skip {
		color: oklch(0.68 0.02 var(--hue, 250));
	}

	#page-loader .loader-skip:hover {
		color: var(--primary, oklch(0.55 0.2 var(--hue, 250)));
		background: oklch(0.5 0.02 var(--hue, 250) / 0.06);
	}

	@media (prefers-reduced-motion: reduce) {
		#page-loader .loader-dot {
			animation: none;
			opacity: 0.8;
		}
		#page-loader .loader-bar {
			transition: none;
		}
		#page-loader {
			transition: none;
		}
	}
</style>

<script is:inline>
	(function () {
		if (window.__pageLoaderInit) return;
		window.__pageLoaderInit = true;

		var loader = document.getElementById("page-loader");
		if (!loader) return;

		var barWrap = loader.querySelector(".loader");
		var barEl = loader.querySelector(".loader-bar");
		var percentEl = document.getElementById("loader-percent");
		var statusEl = document.getElementById("loader-status");
		var skipEl = document.getElementById("loader-close");

		// 只留三个进度点：亮起来 → DOM 好了 → swup 好了。
		// 到点就走，不等任何第三方资源 —— 等它们只会把首屏一起拖长。
		var STEP_START = 10;
		var STEP_DOM = 45;
		var STEP_SWUP = 75;
		var HARD_CAP = 900; // window:load 的兜底
		var MIN_VISIBLE = 160; // 缓存命中时不至于一闪而过
		var EASE = 0.2;

		var REDUCED = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
		var started = performance.now();
		var shown = 0;
		var target = STEP_START;
		var raf = 0;
		var finished = false;

		function setStatus(text) {
			if (statusEl && statusEl.textContent !== text) statusEl.textContent = text;
		}

		function paint(p) {
			p = p < 0 ? 0 : p > 100 ? 100 : p;
			var prev = Math.round(shown);
			shown = p;
			if (barEl) barEl.style.width = p + "%";
			if (barWrap) barWrap.setAttribute("aria-valuenow", String(Math.round(p)));
			// 事件按整数百分点发：灵动岛那边只关心"大概到几成"
			if (Math.round(p) === prev) return;
			if (percentEl) percentEl.textContent = Math.round(p) + "%";
			window.dispatchEvent(new CustomEvent("loader:progress", { detail: { percent: p } }));
		}

		function tick() {
			raf = 0;
			if (finished) return;
			var next = REDUCED ? target : shown + (target - shown) * EASE;
			if (target - next < 0.4) next = target;
			paint(next);
			if (shown < target) raf = requestAnimationFrame(tick);
		}

		function grow(to, status) {
			if (finished) return;
			if (to > target) target = to;
			if (status) setStatus(status);
			if (!raf) raf = requestAnimationFrame(tick);
		}

		function hide() {
			loader.classList.add("hide");
			loader.setAttribute("aria-hidden", "true");
		}

		function done() {
			if (finished) return;
			finished = true;
			if (raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			}
			paint(100);
			setStatus("好了");
			var wait = MIN_VISIBLE - (performance.now() - started);
			window.setTimeout(hide, wait > 0 ? wait : 0);
		}

		function skip() {
			if (finished) return;
			finished = true;
			if (raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			}
			hide();
		}

		if (skipEl) skipEl.addEventListener("click", skip);

		paint(0);
		setStatus("正在准备页面…");
		raf = requestAnimationFrame(tick);

		// 1) DOM 解析完
		function afterDom() {
			grow(STEP_DOM, "正在加载内容…");
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", afterDom, { once: true });
		} else {
			afterDom();
		}

		// 2) swup 起来（它是懒初始化的，来晚了也不影响收尾）
		document.addEventListener(
			"swup:enable",
			function () {
				grow(STEP_SWUP, "快好了…");
			},
			{ once: true },
		);

		// 3) 资源加载完 / 硬上限 → 收工
		function settle() {
			grow(100, "马上就好…");
			done();
		}
		if (document.readyState === "complete") {
			settle();
		} else {
			window.addEventListener("load", settle, { once: true });
		}

		window.setTimeout(settle, HARD_CAP);
	})();
</script>
